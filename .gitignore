# Build outputs
sidecars/
dist/
# PD0 — the spawnable sidecar is a build output, rebuilt by `npm run build:sidecar`.
dist-sidecar/
target/
scripts/
src-tauri/resources/sidecars/

# Python
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
ENV/
env/
build_venv/
*.egg

# Rust
target/
**/*.rs.bk
# Cargo.lock IS committed — see below. Left here as a marker so nobody
# re-adds the ignore:
#   AutoDev is an application, not a library. Without a committed lockfile CI
#   resolves dependencies fresh on every run ("Locking 766 packages to latest
#   compatible versions"), so a build is not reproducible and an upstream
#   release can turn CI red with no change on our side.

# Node/NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Tauri
src-tauri/target/

# Logs
*.log
logs/

# Environment
.env
.env.local
.env.*.local

# User data
.airs/sessions/
.airs/logs/

# Temporary
*.tmp
*.bak
*.cache

# Redis snapshots. AutoDev can start Memurai on Windows (see
# sidecar/mod.rs), and a Redis launched with a repo working directory
# writes its dump here. 175 KB of one was committed once already.
dump.rdb
*.rdb

# Private keys. The update-signing key is generated locally (see
# docs/updater-signing.md) and must never enter the repository.
*.pem
*.key
*.p12
*.pfx
# The DER intermediate the keygen runbook produces. Public half only, so not
# a leak — but it is a stray build artifact, not source.
*.der

# Stale per-member lockfiles. src-tauri and src-cli are members of the ROOT
# workspace, so cargo only ever reads /Cargo.lock; a lockfile inside a member
# is a leftover from when they were separate workspaces and is misleading.
src-tauri/Cargo.lock
src-cli/Cargo.lock
src-shared/Cargo.lock

# The retired Python sidecar / submodule, kept on disk as the reference source
# for capabilities still marked PORT. It is a live git repo with its own history
# and its own uncommitted changes, and its removal is P8's job, gated by TG8-02
# ("the deletion phase cannot complete while any PORT capability is unported").
# Ignored here so 28k untracked files cannot be swept into a commit meanwhile.
submodules/
