<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        AutoDev macOS entitlements — Phase 5.3 Platform Installers.
        Required for hardened runtime + notarization.
    -->

    <!-- Hardened runtime: allow JIT (needed by WebKit/WKWebView in Tauri) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (some WebKit internals require this) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation so dylibs bundled by Tauri load correctly -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network: client access for API calls and update checks -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Network: server for MCP server on localhost:8767 -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- File access: read/write user-selected files (IDE file browser) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- File access: read all files (for workspace browsing) -->
    <key>com.apple.security.files.all</key>
    <true/>

    <!-- subprocess: allow spawning child processes (Python sidecars) -->
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
