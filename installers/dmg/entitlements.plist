<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Arcana macOS entitlements — Phase 5.3 Platform Installers.
        Required for hardened runtime + notarization.
    -->

    <!-- Hardened runtime: allow JIT (needed by WebKit/WKWebView in Tauri) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (some WebKit internals require this) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation so dylibs bundled by Tauri load correctly -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network: client access for API calls and update checks -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- com.apple.security.network.server was REMOVED. It granted Arcana the
         right to LISTEN for incoming connections, and existed solely for the
         in-process MCP server on :8767 that was deleted in P0. Arcana now makes
         only outbound requests (provider APIs, update checks, external MCP
         health probes), which network.client above already covers. -->

    <!-- File access: read/write user-selected files (IDE file browser) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- File access: read all files (for workspace browsing) -->
    <key>com.apple.security.files.all</key>
    <true/>

    <!-- subprocess: the `bash` tool runs commands the model chooses, so the
         app must be able to spawn children.

         ⚠ P8-63 revisited this and KEPT it. The comment named the deleted
         sidecars, but the entitlement was never for them: removing it because
         its comment went stale would disable the tool it was actually
         protecting. -->
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
