// Arcana uses the Windows Experimental_CreateProcessInSandbox contract.
// Field order and defaults in this subset match Microsoft's SBOX schema.
// Source: https://github.com/microsoft/mxc/blob/main/external/windows-sdk/BaseContainerSpecification.fbs
// API contract: https://learn.microsoft.com/en-us/windows/win32/secauthz/createprocessinsandbox
namespace SandboxTechSpecLayout;

enum FilterAction : byte { deny, allow }

table proxy_info {
  url:string;
}

table endpoint_policy {
  default_action:FilterAction = deny;
}

table NetworkPolicy {
  proxy:proxy_info;
  egress:endpoint_policy;
}

table SandboxSpec {
  version:string (required);
  app_container:bool = false;
  integrity_level:uint32 = 0 (deprecated);
  disallow_win32k_system_calls:bool = false;
  ui_restrictions:uint64 = 0;
  least_privilege:bool = false;
  capabilities:string;
  fs_read_write:[string];
  fs_read_only:[string];
  network_policy:NetworkPolicy;
}

root_type SandboxSpec;
file_identifier "SBOX";
