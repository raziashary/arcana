{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoDev",
  "version": "1.0.0",
  "identifier": "com.airs-foundry.autodev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoDev",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "additionalBrowserArgs": "--enable-gpu --use-angle=d3d11 --enable-features=Vulkan"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com https://releases.airs.dev; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sidecars"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI Agent Desktop Platform",
    "longDescription": "AutoDev is an AI-powered development assistant that orchestrates multi-agent workflows, manages tasks, and integrates with your development environment.",
    "copyright": "© 2026 AIRS Foundry. All rights reserved.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"],
        "section": "devel",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "fileAssociations": [
      {
        "ext": ["autodev"],
        "name": "AutoDev Project",
        "description": "AutoDev Project File",
        "role": "Editor"
      }
    ],
    "macOS": {
      "entitlements": "../installers/dmg/entitlements.plist",
      "exceptionDomain": "",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 400,
          "y": 100
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "dialog": {},
    "fs": {}
  }
}
