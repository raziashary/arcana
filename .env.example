# Optional local credential for the explicitly enabled Google/Gemini live-provider
# smoke tests in arcana-core/tests/live_provider_smoke.rs.
# The desktop app and arcanactl do not load provider keys from this file. Add the
# same Gemini key in the desktop app's Settings > Providers to use it there.
# GEMINI_API_KEY is not read by the live smoke; its expected name is GOOGLE_API_KEY.
GOOGLE_API_KEY=
